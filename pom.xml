<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.marqrdt.stainedglass</groupId>
	<artifactId>StainedGlass</artifactId>
	<version>1.1.0</version>
	<name>Stained Glass :: Game</name>
	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>
	<build>
		<sourceDirectory>src</sourceDirectory>
		<resources>
			<!-- filtered so that ${project.version} below is substituted with
			     the actual POM version at build time -->
			<resource>
				<directory>src</directory>
				<filtering>true</filtering>
				<includes>
					<include>META-INF/stainedGlass.properties</include>
				</includes>
			</resource>
			<!-- everything else (including binary icon assets) is copied as-is,
			     unfiltered, to avoid corrupting non-text resources -->
			<resource>
				<directory>src</directory>
				<filtering>false</filtering>
				<excludes>
					<exclude>**/*.java</exclude>
					<exclude>META-INF/stainedGlass.properties</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<propertiesEncoding>UTF-8</propertiesEncoding>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.1</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>org.marqrdt.stainedglass.StainedGlassJFrame</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<skipTests>false</skipTests>
					<!-- <excludes> <exclude>**/TestPhrase.java</exclude> </excludes> <includes>
						<include>**/TestPhraseFileReader.java</include> </includes> -->
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<goals>
							<goal>java</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<mainClass>org.marqrdt.stainedglass.StainedGlassJFrame</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<dependencies>
	</dependencies>
	<profiles>
		<!-- Produces a native macOS .dmg installer via jpackage (bundled with
		     JDK 14+). jpackage must be on the PATH. Build with:
		         mvn -Pmac-installer clean verify
		     The resulting installer is written to target/installer/. -->
		<profile>
			<id>mac-installer</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<!-- jpackage copies its entire input directory into the
							     app bundle, so stage just the runnable jar in its own
							     clean directory rather than pointing it at all of
							     target/ (which also has classes/, maven-status/, etc). -->
							<execution>
								<id>stage-jpackage-input</id>
								<phase>verify</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
									<resources>
										<resource>
											<directory>${project.build.directory}</directory>
											<includes>
												<include>${project.build.finalName}.jar</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>jpackage-mac-dmg</id>
								<phase>verify</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>jpackage</executable>
									<arguments>
										<argument>--type</argument>
										<argument>dmg</argument>
										<argument>--name</argument>
										<argument>StainedGlass</argument>
										<argument>--app-version</argument>
										<argument>${project.version}</argument>
										<argument>--vendor</argument>
										<argument>marqrdt</argument>
										<argument>--description</argument>
										<argument>StainedGlass -- a Java port of a classic Motorola 68K Mac puzzle game</argument>
										<argument>--input</argument>
										<argument>${project.build.directory}/jpackage-input</argument>
										<argument>--main-jar</argument>
										<argument>${project.build.finalName}.jar</argument>
										<argument>--main-class</argument>
										<argument>org.marqrdt.stainedglass.StainedGlassJFrame</argument>
										<argument>--mac-package-identifier</argument>
										<argument>org.marqrdt.stainedglass</argument>
										<argument>--icon</argument>
										<argument>${project.basedir}/installer/mac/StainedGlass.icns</argument>
										<argument>--dest</argument>
										<argument>${project.build.directory}/installer</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!-- Produces a native Linux installer via jpackage (bundled with
		     JDK 14+). jpackage must be on the PATH. Defaults to an .rpm
		     package (Fedora/RHEL family); requires 'rpmbuild' to be
		     installed (e.g. sudo dnf install rpm-build). For a .deb
		     package instead (Debian/Ubuntu family, requires 'fakeroot',
		     e.g. sudo apt install fakeroot), override the installer
		     type property:
		         mvn -Plinux-installer -Dlinux.installer.type=deb clean verify
		     Build with:
		         mvn -Plinux-installer clean verify
		     The resulting installer is written to target/installer/. -->
		<profile>
			<id>linux-installer</id>
			<properties>
				<linux.installer.type>rpm</linux.installer.type>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<!-- jpackage copies its entire input directory into the
							     app image, so stage just the runnable jar in its own
							     clean directory rather than pointing it at all of
							     target/ (which also has classes/, maven-status/, etc). -->
							<execution>
								<id>stage-jpackage-input</id>
								<phase>verify</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
									<resources>
										<resource>
											<directory>${project.build.directory}</directory>
											<includes>
												<include>${project.build.finalName}.jar</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>jpackage-linux</id>
								<phase>verify</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>jpackage</executable>
									<arguments>
										<argument>--type</argument>
										<argument>${linux.installer.type}</argument>
										<argument>--name</argument>
										<argument>StainedGlass</argument>
										<argument>--app-version</argument>
										<argument>${project.version}</argument>
										<argument>--vendor</argument>
										<argument>marqrdt</argument>
										<argument>--description</argument>
										<argument>StainedGlass -- a Java port of a classic Motorola 68K Mac puzzle game</argument>
										<argument>--input</argument>
										<argument>${project.build.directory}/jpackage-input</argument>
										<argument>--main-jar</argument>
										<argument>${project.build.finalName}.jar</argument>
										<argument>--main-class</argument>
										<argument>org.marqrdt.stainedglass.StainedGlassJFrame</argument>
										<argument>--linux-package-name</argument>
										<argument>stainedglass</argument>
										<argument>--linux-app-category</argument>
										<argument>Game</argument>
										<argument>--linux-shortcut</argument>
										<argument>--dest</argument>
										<argument>${project.build.directory}/installer</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
